<Project>
  <!--
    Application version for every assembly. The Output panel shows it at startup ("Vortex Backup Tool X.Y.Z started")
    and Explorer shows it in the .exe properties. Rules and history: Documentation/Version_History.md.
    The .githooks/pre-commit hook raises the patch number on every commit; for a big change set the next minor
    version here yourself (0.19.4 -> 0.20.0) in the same commit, and the hook leaves it alone.
  -->
  <PropertyGroup>
    <Version>0.19.2</Version>
  </PropertyGroup>

  <!--
    Release builds embed debug symbols in every assembly, so the portable single-file publish is just one .exe
    (no loose .pdb files) while exception details in the log files still include file names and line numbers.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
