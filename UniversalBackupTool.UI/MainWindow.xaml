<ui:FluentWindow
    x:Class="UniversalBackupTool.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:UniversalBackupTool.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:UniversalBackupTool.UI.Views"
    Title="{Binding ApplicationTitle}"
    Width="1240"
    Height="860"
    MinWidth="900"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="pack://application:,,,/Assets/AppIcon.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding ApplicationTitle}" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            The navigation pane runs the full window height (Settings at the bottom). The Output tool window and the
            status bar live in ContentOverlay, docked to the bottom of the page area only; FrameMargin is kept equal to
            their height (MainWindow.xaml.cs) so pages end right above them instead of being covered.
        -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Profiles" TargetPageType="{x:Type views:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Games24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Vanilla &amp; Purge" TargetPageType="{x:Type views:VanillaPurgePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Broom24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Backup" TargetPageType="{x:Type views:BackupPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Archive24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Restore" TargetPageType="{x:Type views:RestorePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="BottomDock" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Drag grip to resize the Output tool window.  -->
                    <Thumb
                        x:Name="OutputResizeGrip"
                        Grid.Row="0"
                        Height="6"
                        Cursor="SizeNS"
                        DragDelta="OnOutputResizeGripDragDelta"
                        ToolTip="Drag to resize the Output window">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <!--  Output tool window (Visual Studio style): slim title strip with icon commands, flat monospace log.  -->
                    <Border
                        x:Name="OutputPanel"
                        Grid.Row="1"
                        Height="170"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="12,0,4,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="WindowConsole20" />
                                        <TextBlock Style="{StaticResource ToolWindowTitleTextStyle}" Text="Output" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button
                                            Width="28"
                                            Height="26"
                                            Padding="0"
                                            Appearance="Transparent"
                                            Click="OnCopyAllOutputClick"
                                            Icon="{ui:SymbolIcon Copy20}"
                                            ToolTip="Copy all (select lines and press Ctrl+C to copy only those)" />
                                        <ui:Button
                                            Width="28"
                                            Height="26"
                                            Padding="0"
                                            Appearance="Transparent"
                                            Command="{Binding ClearOutputCommand}"
                                            Icon="{ui:SymbolIcon Delete20}"
                                            ToolTip="Clear the panel (the log file in Logs keeps everything)" />
                                        <ui:Button
                                            Width="28"
                                            Height="26"
                                            Padding="0"
                                            Appearance="Transparent"
                                            Click="OnOpenLogsFolderClick"
                                            Icon="{ui:SymbolIcon FolderOpen24}"
                                            ToolTip="Open the Logs folder (one log file per day, kept 30 days)" />
                                        <ui:Button
                                            Width="28"
                                            Height="26"
                                            Padding="0"
                                            Appearance="Transparent"
                                            Command="{Binding HideOutputCommand}"
                                            Icon="{ui:SymbolIcon Dismiss16}"
                                            ToolTip="Hide Output (show it again from the status bar)" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox
                                Grid.Row="1"
                                Padding="0,4"
                                helpers:OutputListBehavior.IsEnabled="True"
                                FontFamily="{StaticResource MonospaceFontFamily}"
                                FontSize="12"
                                ItemsSource="{Binding OutputEntries}"
                                SelectionMode="Extended"
                                Style="{StaticResource FlatListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding TimeText}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!--  Status bar (Visual Studio style): operation and progress on the left, Output toggle on the right.  -->
                    <Border
                        Grid.Row="2"
                        Height="28"
                        Padding="12,0,4,0"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Operation and phase: takes the remaining width and is cut off with "..." when it does not
                                fit; the tooltip shows the full status and the current file. A Grid (not a horizontal
                                StackPanel) is needed so the text gets a finite width and can be trimmed.
                            -->
                            <Grid
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="{Binding StatusToolTip}"
                                ToolTipService.IsEnabled="{Binding IsOperationRunning}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:ProgressRing
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,8,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource StatusBarTextStyle}"
                                    Text="{Binding StatusText}" />
                            </Grid>

                            <!--  Counters, progress and Cancel: always shown in full, the phase text gives way instead.  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    Style="{StaticResource StatusBarTextStyle}"
                                    Text="{Binding ProgressCountsText}"
                                    TextTrimming="None" />
                                <ProgressBar
                                    Width="120"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding ProgressPercent, Mode=OneWay}" />
                                <TextBlock
                                    MinWidth="36"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource StatusBarTextStyle}"
                                    Text="{Binding ProgressPercentText}"
                                    TextAlignment="Right"
                                    TextTrimming="None" />
                                <ui:Button
                                    Height="22"
                                    Margin="4,0,0,0"
                                    Padding="8,0"
                                    Appearance="Transparent"
                                    Command="{Binding CancelOperationCommand}"
                                    FontSize="12"
                                    Icon="{ui:SymbolIcon Dismiss16}"
                                    ToolTip="Cancel the running operation">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Content" Value="Cancel" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                                    <Setter Property="Content" Value="Cancelling..." />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>

                            <ui:Button
                                Grid.Column="2"
                                Height="22"
                                Margin="12,0,0,0"
                                Padding="8,0"
                                Appearance="Transparent"
                                Command="{Binding ToggleOutputCommand}"
                                Content="Output"
                                FontSize="12"
                                Icon="{ui:SymbolIcon PanelBottom20}"
                                ToolTip="Show or hide the Output window" />
                        </Grid>
                    </Border>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>