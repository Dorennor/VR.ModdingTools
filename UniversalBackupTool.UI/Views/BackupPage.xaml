<Page
    x:Class="UniversalBackupTool.UI.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UniversalBackupTool.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:UniversalBackupTool.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Backup"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Style="{StaticResource AppPageStyle}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1072" />
            </Grid.ColumnDefinitions>

            <StackPanel Style="{StaticResource PageContentPanelStyle}">
                <Grid Style="{StaticResource PageHeaderGridStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Backup" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Create incremental snapshots of your games." />
                    </StackPanel>
                </Grid>

                <!--  Paused job notice, styled like a Windows 11 warning InfoBar.  -->
                <controls:SettingsCard
                    Margin="0,20,0,0"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Description="{Binding PausedJobMessage}"
                    Header="A backup needs to continue"
                    Visibility="{Binding HasPausedJob, Converter={StaticResource BoolToVisibility}}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                    </controls:SettingsCard.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ResumeCommand}"
                            Content="Continue backup"
                            IsEnabled="{Binding CanStartOperation}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding DiscardPausedJobCommand}"
                            Content="Discard"
                            IsEnabled="{Binding CanStartOperation}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!--  Create backup  -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Create backup" />

                <!--
                    Profile picker sized for many games: search, select all / clear, live "N of M selected",
                    and a bounded three-column grid that scrolls (wheel passes to the page at the edges).
                -->
                <Border
                    Margin="0,0,0,4"
                    Padding="16,12"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="2,0,20,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="Games24" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Profiles" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="{Binding SelectedTargetsSummary}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    Command="{Binding ClearTargetSelectionCommand}"
                                    Content="Clear"
                                    ToolTip="Deselect every game in both groups" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="42,12,0,0" Visibility="{Binding HasNoProfiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Search games"
                                    Text="{Binding TargetFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:ToggleSwitch
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Hide uninstalled games"
                                    IsChecked="{Binding HideUninstalledGames, Mode=TwoWay}"
                                    ToolTip="Hides games that are not installed and have no mods in their staging folder" />
                            </Grid>

                            <Border
                                Margin="0,8,0,0"
                                Padding="8,6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.Resources>
                                        <!--
                                            One group of games (managed by Vortex / other games): a header with the group's
                                            count and its own Select all, then the games in three columns. While games of the
                                            other group are selected the group is locked (dimmed, checkboxes disabled).
                                        -->
                                        <DataTemplate x:Key="TargetSectionTemplate">
                                            <StackPanel Margin="0,2,0,6" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="4,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Title}" />
                                                        <TextBlock
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CaptionTextStyle}"
                                                            Text="{Binding Summary}" />
                                                    </StackPanel>
                                                    <ui:Button
                                                        Grid.Column="1"
                                                        Command="{Binding ToggleSelectAllCommand}"
                                                        Content="{Binding SelectAllButtonText}"
                                                        ToolTip="Select or deselect every game of this group (only the matching ones while searching)" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding VisibleTargets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid VerticalAlignment="Top" Columns="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox
                                                                Margin="4,2"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                IsEnabled="{Binding IsSelectable}"
                                                                ToolTip="{Binding DisplayName}">
                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Grid.Resources>
                                    <ScrollViewer
                                        MaxHeight="320"
                                        helpers:NestedScrollBehavior.PassWheelAtEdges="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <!--  The scrollbar is drawn over the content: the right margin keeps it off the Select all buttons.  -->
                                        <StackPanel Margin="0,0,20,0">
                                            <ContentControl Content="{Binding VortexTargets}" ContentTemplate="{StaticResource TargetSectionTemplate}" />
                                            <ContentControl Content="{Binding OtherTargets}" ContentTemplate="{StaticResource TargetSectionTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <TextBlock
                                        Margin="4,6"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{Binding NoVisibleTargetsText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasNoVisibleTargets, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{Binding HiddenGamesSummary}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasHiddenGamesSummary, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{Binding LockedComponentsSummary}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasLockedComponents, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:SettingsCard
                    Description="One archive per mod. Unchanged mods reuse their previous archive, so only updated mods are packed again. Only for games managed by Vortex."
                    Header="Staging folders"
                    Icon="{ui:SymbolIcon Archive24}"
                    Visibility="{Binding ShowVortexComponents, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsStagingOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseStaging}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="New files in the game folder that are not in the vanilla snapshot (the same list the purge preview shows)."
                    Header="Game configs"
                    Icon="{ui:SymbolIcon Settings24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsGameConfigsOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseGameFolder}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Everything added to the game folder, in one archive: configs, new files and deployed mod files (with their real content). Fast: only compares names and file kinds with the vanilla snapshot, never reads vanilla files, so a reinstall or file verification does not slow it down."
                    Header="New game files (configs + mods)"
                    Icon="{ui:SymbolIcon DocumentAdd24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsGameAdditionsOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseGameFolder}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Like New game files, plus vanilla files whose content differs from the vanilla snapshot. Vanilla files with a new timestamp are read once to compare their content (can take minutes for a large game after a reinstall); identical ones are remembered and skipped next time."
                    Header="Changed game files"
                    Icon="{ui:SymbolIcon DocumentEdit24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsGameChangesOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseGameFolder}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Vortex settings, mod lists, profiles and load orders of all games. Backed up once per run into the shared #Vortex AppData# folder (folder set in Settings). Close Vortex first."
                    Header="Vortex AppData"
                    Icon="{ui:SymbolIcon Storage24}"
                    Visibility="{Binding ShowVortexComponents, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeVortexAppData, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Extra folders and files listed in each profile."
                    Header="Custom paths"
                    Icon="{ui:SymbolIcon FolderAdd24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsCustomFoldersOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseCustomPaths}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="The whole game folder with all deployed mods and configs as one zip in the export folder of the game's profile, ready to unpack and play: links are stored as real files. Uses the ignore list and compression settings. The old archive is deleted first, after you confirm, so a cloud drive does not download it. Games without an export folder are skipped."
                    Header="Full game"
                    Icon="{ui:SymbolIcon CloudArrowUp24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IsFullGameOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanUseFullGame}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding StartBackupCommand}"
                        Content="Start backup"
                        Icon="{ui:SymbolIcon ArrowUpload24}"
                        IsEnabled="{Binding CanStartOperation}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>