<Page
    x:Class="UniversalBackupTool.UI.Views.BackupRestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:UniversalBackupTool.UI.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Backup &amp; Restore"
    ScrollViewer.CanContentScroll="False"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20,40,40">
            <ui:TextBlock FontTypography="Title" Text="Backup &amp; Restore" />
            <ui:TextBlock
                Margin="0,4,0,24"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Execute backup jobs or restore state from Google Drive." />

            <ui:InfoBar
                Title="Error"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />

            <ui:InfoBar
                Title="Attention"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasWarningMessage}"
                Message="{Binding WarningMessage}"
                Severity="Warning" />

            <ui:InfoBar
                Title="Done"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasStatusMessage}"
                Message="{Binding StatusMessage}"
                Severity="Success" />

            <ui:InfoBar
                Title="Paused Job Found:"
                Margin="0,0,0,20"
                IsClosable="False"
                IsOpen="{Binding HasPausedJob}"
                Message="{Binding PausedJobMessage}"
                Severity="Warning">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding ResumeCommand}"
                        Content="Resume &amp; Append"
                        IsEnabled="{Binding IsIdle}" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding DiscardPausedJobCommand}"
                        Content="Discard"
                        IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </ui:InfoBar>

            <ui:Card
                Margin="0,0,0,24"
                Padding="20"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel helpers:StackPanelSpacing.Spacing="8">
                    <ui:TextBlock FontTypography="Subtitle" Text="Progress" />
                    <ProgressBar
                        Height="8"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <ui:TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" />
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CurrentItemText}"
                        TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding CancelCommand}" Content="Cancel" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,24" Padding="20">
                <StackPanel helpers:StackPanelSpacing.Spacing="20">
                    <ui:TextBlock FontTypography="Subtitle" Text="Create Backup" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" helpers:StackPanelSpacing.Spacing="4">
                            <ui:TextBlock
                                Margin="0,0,0,4"
                                FontTypography="BodyStrong"
                                Text="Target Profiles" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="No profiles yet. Add one on the Dashboard."
                                Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding GameName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2" helpers:StackPanelSpacing.Spacing="4">
                            <ui:TextBlock
                                Margin="0,0,0,4"
                                FontTypography="BodyStrong"
                                Text="Components to Backup" />
                            <CheckBox Content="Staging Folders (1 archive per mod)" IsChecked="{Binding IncludeStaging, Mode=TwoWay}" />
                            <CheckBox Content="Game Configs (Diff vs Snapshot)" IsChecked="{Binding IncludeGameConfigs, Mode=TwoWay}" />
                            <CheckBox Content="Vortex AppData (Roaming)" IsChecked="{Binding IncludeVortexAppData, Mode=TwoWay}" />
                            <CheckBox Content="Custom Folders" IsChecked="{Binding IncludeCustomFolders, Mode=TwoWay}" />
                            <Separator Margin="0,6,0,6" />
                            <CheckBox Content="Pack as Single Monolithic Archive" IsChecked="{Binding PackMonolithic, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding StartBackupCommand}"
                        Content="Start Backup Job"
                        IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20">
                <StackPanel helpers:StackPanelSpacing.Spacing="12">
                    <ui:TextBlock FontTypography="Subtitle" Text="Restore from Drive" />
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Files that would be overwritten are saved to a Safety Backup before restoring."
                        TextWrapping="Wrap" />
                    <ui:Button
                        Command="{Binding BrowseRestoreFolderCommand}"
                        Content="Browse Backup Directory..."
                        IsEnabled="{Binding IsIdle}" />

                    <StackPanel helpers:StackPanelSpacing.Spacing="8" Visibility="{Binding HasRestoreManifest, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock
                            FontTypography="BodyStrong"
                            Text="{Binding RestoreSummary}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding RestoreFolderPath}"
                            TextWrapping="Wrap" />

                        <CheckBox
                            Content="Staging folders"
                            IsChecked="{Binding RestoreStaging, Mode=TwoWay}"
                            Visibility="{Binding RestoreHasStaging, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox
                            Content="Game configs"
                            IsChecked="{Binding RestoreGameConfigs, Mode=TwoWay}"
                            Visibility="{Binding RestoreHasGameConfigs, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox
                            Content="Vortex AppData"
                            IsChecked="{Binding RestoreAppData, Mode=TwoWay}"
                            Visibility="{Binding RestoreHasAppData, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox
                            Content="Custom folders"
                            IsChecked="{Binding RestoreCustomFolders, Mode=TwoWay}"
                            Visibility="{Binding RestoreHasCustomFolders, Converter={StaticResource BoolToVisibility}}" />

                        <ui:TextBlock
                            Margin="0,8,0,0"
                            FontTypography="BodyStrong"
                            Text="Will be restored to:" />
                        <ItemsControl ItemsSource="{Binding RestorePlanLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,2"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button
                            Margin="0,8,0,0"
                            Appearance="Danger"
                            Command="{Binding RestoreCommand}"
                            Content="Restore Selected"
                            IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>