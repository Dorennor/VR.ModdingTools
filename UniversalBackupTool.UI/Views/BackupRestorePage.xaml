<Page
    x:Class="UniversalBackupTool.UI.Views.BackupRestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:UniversalBackupTool.UI.Controls"
    xmlns:helpers="clr-namespace:UniversalBackupTool.UI.Helpers"
    Title="Backup &amp; Restore"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Style="{StaticResource AppPageStyle}"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Drive picker + on/off switch on the right of a restore component row.  -->
        <Style
            x:Key="RestoreDriveComboStyle"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="ComboBox">
            <Setter Property="Width" Value="84" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="ToolTip" Value="Drive to restore to" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1072" />
            </Grid.ColumnDefinitions>

            <StackPanel Style="{StaticResource PageContentPanelStyle}">
                <Grid Style="{StaticResource PageHeaderGridStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Backup &amp; Restore" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Create incremental snapshots of your games, or restore a previous one." />
                    </StackPanel>
                </Grid>

                <!--  Paused job notice, styled like a Windows 11 warning InfoBar.  -->
                <controls:SettingsCard
                    Margin="0,20,0,0"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Description="{Binding PausedJobMessage}"
                    Header="A backup needs to continue"
                    Visibility="{Binding HasPausedJob, Converter={StaticResource BoolToVisibility}}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                    </controls:SettingsCard.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ResumeCommand}"
                            Content="Continue backup"
                            IsEnabled="{Binding CanStartOperation}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding DiscardPausedJobCommand}"
                            Content="Discard"
                            IsEnabled="{Binding CanStartOperation}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!--  Create backup  -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Create backup" />

                <!--
                    Profile picker sized for many games: search, select all / clear, live "N of M selected",
                    and a bounded three-column grid that scrolls (wheel passes to the page at the edges).
                -->
                <Border
                    Margin="0,0,0,4"
                    Padding="16,12"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Margin="2,0,20,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="Games24" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Profiles" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="{Binding SelectedTargetsSummary}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    Command="{Binding ToggleSelectAllTargetsCommand}"
                                    Content="{Binding SelectAllButtonText}"
                                    ToolTip="Select or deselect every game in the list (only the matching ones while searching)" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearTargetSelectionCommand}"
                                    Content="Clear" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="42,12,0,0" Visibility="{Binding HasNoProfiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:TextBox
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Search games"
                                Text="{Binding TargetFilter, UpdateSourceTrigger=PropertyChanged}" />

                            <Border
                                Margin="0,8,0,0"
                                Padding="8,6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <ScrollViewer
                                        MaxHeight="232"
                                        helpers:NestedScrollBehavior.PassWheelAtEdges="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding VisibleTargets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid VerticalAlignment="Top" Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Margin="4,2"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        ToolTip="{Binding GameName}">
                                                        <TextBlock
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding GameName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock
                                        Margin="4,6"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="No games match the search."
                                        Visibility="{Binding HasNoVisibleTargets, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:SettingsCard
                    Description="One archive per mod. Unchanged mods reuse their previous archive, so only updated mods are packed again. Only for games managed by Vortex."
                    Header="Staging folders"
                    Icon="{ui:SymbolIcon Archive24}"
                    Visibility="{Binding ShowVortexComponents, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeStaging, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="New files in the game folder that are not in the vanilla snapshot (the same list the purge preview shows)."
                    Header="Game configs"
                    Icon="{ui:SymbolIcon Settings24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeGameConfigs, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Everything in the game folder that differs from the vanilla snapshot, in one archive: new files, configs, modified vanilla files and deployed mod files (with their real content)."
                    Header="Changed game files"
                    Icon="{ui:SymbolIcon DocumentEdit24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeGameChanges, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Vortex settings, profiles and load order. Only for games managed by Vortex."
                    Header="Vortex AppData"
                    Icon="{ui:SymbolIcon Storage24}"
                    Visibility="{Binding ShowVortexComponents, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeVortexAppData, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Extra folders and files listed in each profile."
                    Header="Custom paths"
                    Icon="{ui:SymbolIcon FolderAdd24}">
                    <ui:ToggleSwitch
                        IsChecked="{Binding IncludeCustomFolders, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard>

                <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding StartBackupCommand}"
                        Content="Start backup"
                        Icon="{ui:SymbolIcon ArrowUpload24}"
                        IsEnabled="{Binding CanStartOperation}" />
                </StackPanel>

                <!--  Restore  -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Restore" />

                <controls:SettingsCard
                    Description="{Binding RestoreSummary, TargetNullValue='Select a dated backup folder, for example ...\\Game\\staging\\2026-10-31_12-00-00.'}"
                    Header="Backup to restore"
                    Icon="{ui:SymbolIcon History24}">
                    <ui:Button
                        Command="{Binding BrowseRestoreFolderCommand}"
                        Content="Browse..."
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        IsEnabled="{Binding IsIdle}" />
                </controls:SettingsCard>

                <StackPanel Visibility="{Binding HasRestoreManifest, Converter={StaticResource BoolToVisibility}}">
                    <controls:SettingsCard
                        Description="Mod folders from the staging snapshot."
                        Header="Staging folders"
                        Icon="{ui:SymbolIcon Archive24}"
                        Visibility="{Binding RestoreHasStaging, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                ItemsSource="{Binding AvailableDrives}"
                                SelectedItem="{Binding RestoreStagingDrive, Mode=TwoWay}"
                                Style="{StaticResource RestoreDriveComboStyle}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding RestoreStaging, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="New game folder files from the configs snapshot."
                        Header="Game configs"
                        Icon="{ui:SymbolIcon Settings24}"
                        Visibility="{Binding RestoreHasGameConfigs, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                ItemsSource="{Binding AvailableDrives}"
                                SelectedItem="{Binding RestoreGameConfigsDrive, Mode=TwoWay}"
                                Style="{StaticResource RestoreDriveComboStyle}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding RestoreGameConfigs, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="New and modified game folder files from the changes snapshot."
                        Header="Changed game files"
                        Icon="{ui:SymbolIcon DocumentEdit24}"
                        Visibility="{Binding RestoreHasGameChanges, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                ItemsSource="{Binding AvailableDrives}"
                                SelectedItem="{Binding RestoreGameConfigsDrive, Mode=TwoWay}"
                                Style="{StaticResource RestoreDriveComboStyle}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding RestoreGameChanges, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="Vortex settings, profiles and load order."
                        Header="Vortex AppData"
                        Icon="{ui:SymbolIcon Storage24}"
                        Visibility="{Binding RestoreHasAppData, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                ItemsSource="{Binding AvailableDrives}"
                                SelectedItem="{Binding RestoreAppDataDrive, Mode=TwoWay}"
                                Style="{StaticResource RestoreDriveComboStyle}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding RestoreAppData, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="Extra folders and files from the profile."
                        Header="Custom paths"
                        Icon="{ui:SymbolIcon FolderAdd24}"
                        Visibility="{Binding RestoreHasCustomFolders, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                ItemsSource="{Binding AvailableDrives}"
                                SelectedItem="{Binding RestoreCustomFoldersDrive, Mode=TwoWay}"
                                Style="{StaticResource RestoreDriveComboStyle}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding RestoreCustomFolders, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <Border Margin="0,0,0,4" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Will be restored to" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RestorePlanLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{Binding RestoreFolderPath, StringFormat='Source: {0}'}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                        <ui:Button
                            Appearance="Danger"
                            Command="{Binding RestoreCommand}"
                            Content="Restore selected"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            IsEnabled="{Binding CanStartOperation}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Margin="1,16,0,0"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Files that a restore would overwrite are saved to a safety backup first. When moving backups, keep each component's _archives folder next to its dated snapshot folders: snapshots share the archives stored there." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>