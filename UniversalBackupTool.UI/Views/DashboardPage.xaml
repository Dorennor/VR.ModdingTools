<Page
    x:Class="UniversalBackupTool.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:UniversalBackupTool.UI.Helpers"
    Title="Dashboard"
    ScrollViewer.CanContentScroll="False"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,20,40,40" helpers:StackPanelSpacing.Spacing="0">
            <ui:TextBlock FontTypography="Title" Text="Game Profiles" />
            <ui:TextBlock
                Margin="0,4,0,24"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Manage games, staging folders, and custom paths." />

            <ui:InfoBar
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error"
                Title="Error" />

            <ui:InfoBar
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding HasStatusMessage}"
                Message="{Binding StatusMessage}"
                Severity="Success"
                Title="Done" />

            <Grid Margin="0,0,0,20">
                <ui:Button
                    Command="{Binding ToggleFindCommand}"
                    Content="Find on other disk"
                    Icon="{ui:SymbolIcon Search24}" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Command="{Binding AddProfileCommand}"
                    Content="Add New Profile"
                    Icon="{ui:SymbolIcon Add24}" />
            </Grid>

            <ui:Card
                Margin="0,0,0,24"
                Padding="20"
                Visibility="{Binding IsFindVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel helpers:StackPanelSpacing.Spacing="12">
                    <ui:TextBlock FontTypography="Subtitle" Text="Find on other disk" />
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Pick one of the profile paths. The same path will be searched on all other local disks." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding FindablePaths}"
                            SelectedItem="{Binding SelectedFindPath, Mode=TwoWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Appearance="Primary"
                            Command="{Binding FindOnOtherDisksCommand}"
                            Content="Find"
                            Icon="{ui:SymbolIcon Search24}" />
                    </Grid>

                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding FindMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasFindMessage, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding FoundCandidates}"
                            SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Appearance="Primary"
                            Command="{Binding ApplyCandidateCommand}"
                            Content="Use this path and save"
                            Icon="{ui:SymbolIcon Save24}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card
                Margin="0,0,0,24"
                Padding="20"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel helpers:StackPanelSpacing.Spacing="12">
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding EditorTitle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Game name:" />
                        <ui:TextBox Grid.Column="1" Text="{Binding EditGameName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Vortex staging:" />
                        <ui:TextBox Grid.Column="1" Text="{Binding EditVortexStagingPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="2"
                            Width="72"
                            Margin="12,0,0,0"
                            ItemsSource="{Binding AvailableDrives}"
                            SelectedItem="{Binding EditVortexStagingDrive, Mode=TwoWay}"
                            ToolTip="Change only the drive letter" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            Command="{Binding BrowseVortexStagingPathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Game root:" />
                        <ui:TextBox Grid.Column="1" Text="{Binding EditGameRootPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="2"
                            Width="72"
                            Margin="12,0,0,0"
                            ItemsSource="{Binding AvailableDrives}"
                            SelectedItem="{Binding EditGameRootDrive, Mode=TwoWay}"
                            ToolTip="Change only the drive letter" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            Command="{Binding BrowseGameRootPathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Vortex AppData:" />
                        <ui:TextBox Grid.Column="1" Text="{Binding EditVortexAppDataPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="2"
                            Width="72"
                            Margin="12,0,0,0"
                            ItemsSource="{Binding AvailableDrives}"
                            SelectedItem="{Binding EditVortexAppDataDrive, Mode=TwoWay}"
                            ToolTip="Change only the drive letter" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            Command="{Binding BrowseVortexAppDataPathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Top" Text="Custom folders:" />
                        <ui:TextBox
                            Grid.Column="1"
                            Height="90"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Text="{Binding EditCustomFoldersText, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            Command="{Binding AddCustomFolderCommand}"
                            Content="Add folder"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="One folder per line." />

                    <CheckBox Content="Apply global ignore list to this profile" IsChecked="{Binding EditUseIgnoreList}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,12,0"
                            Command="{Binding CancelEditCommand}"
                            Content="Cancel" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding SaveProfileCommand}"
                            Content="Save Profile"
                            Icon="{ui:SymbolIcon Save24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock
                Margin="0,0,0,24"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="No profiles yet. Press &quot;Add New Profile&quot; to create one."
                Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,24" Padding="20">
                            <StackPanel helpers:StackPanelSpacing.Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontTypography="Subtitle"
                                        Text="{Binding GameName}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="Edit Profile" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="Delete" />
                                </Grid>

                                <Grid Visibility="{Binding HasVortexStagingPath, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Vortex Staging:" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsReadOnly="True"
                                        Text="{Binding VortexStagingPath, Mode=OneWay}" />
                                </Grid>

                                <Grid Visibility="{Binding HasGameRootPath, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Game Root:" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsReadOnly="True"
                                        Text="{Binding GameRootPath, Mode=OneWay}" />
                                </Grid>

                                <Grid Visibility="{Binding HasVortexAppDataPath, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Vortex AppData:" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsReadOnly="True"
                                        Text="{Binding VortexAppDataPath, Mode=OneWay}" />
                                </Grid>

                                <StackPanel
                                    helpers:StackPanelSpacing.Spacing="8"
                                    Visibility="{Binding HasCustomFolders, Converter={StaticResource BoolToVisibility}}">
                                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Custom Folders Included:" />
                                    <Border
                                        Padding="12"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding CustomFoldersText}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>

                                <CheckBox
                                    Content="Apply global ignore list to this profile"
                                    IsChecked="{Binding UseIgnoreList, Mode=OneWay}"
                                    IsEnabled="False" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>