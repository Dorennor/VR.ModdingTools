<Page
    x:Class="UniversalBackupTool.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:UniversalBackupTool.UI.Controls"
    Title="Settings"
    d:DesignHeight="900"
    d:DesignWidth="900"
    Style="{StaticResource AppPageStyle}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1072" />
            </Grid.ColumnDefinitions>

            <StackPanel Style="{StaticResource PageContentPanelStyle}">
                <Grid Style="{StaticResource PageHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Backup destination, compression, retention and ignore rules." />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="Save settings"
                        Icon="{ui:SymbolIcon Save24}" />
                </Grid>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Appearance" />

                <controls:SettingsCard
                    Description="Light or dark, or follow the Windows setting. Applied and saved immediately."
                    Header="App theme"
                    Icon="{ui:SymbolIcon Color24}">
                    <ComboBox
                        Width="220"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                        SelectedValuePath="Theme" />
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Storage" />

                <controls:SettingsCard
                    Description="Root folder for all backups, for example a Google Drive folder. Each game gets its own sub-folder."
                    Header="Backup destination"
                    Icon="{ui:SymbolIcon FolderArrowRight24}"
                    IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GoogleDriveBackupPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseGoogleDrivePathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Files that a purge or restore would delete or overwrite are archived here first."
                    Header="Safety backups"
                    Icon="{ui:SymbolIcon Shield24}"
                    IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SafetyBackupPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseSafetyBackupPathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Vortex settings, mod lists, profiles and load orders of all games, usually %APPDATA%\Vortex. Backed up once per backup run into the #Vortex AppData# folder of the backup destination, and restored here."
                    Header="Vortex AppData folder"
                    Icon="{ui:SymbolIcon Storage24}"
                    IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding VortexAppDataPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseVortexAppDataPathCommand}"
                            Content="Browse"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Compression" />

                <controls:SettingsCard
                    Description="Disable compression for large files to speed up backups. Each file uses the smallest matching size limit."
                    Header="Compression rules"
                    Icon="{ui:SymbolIcon ArchiveSettings24}">
                    <ui:Button
                        Command="{Binding AddRuleCommand}"
                        Content="Add rule"
                        Icon="{ui:SymbolIcon Add24}" />
                </controls:SettingsCard>

                <ItemsControl ItemsSource="{Binding CompressionRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="56,8,16,8"
                                Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlimited}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="Files up to" />
                                        <ui:NumberBox
                                            Width="120"
                                            Margin="12,0"
                                            MaxDecimalPlaces="0"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Hidden"
                                            Value="{Binding MaxSizeMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="MB" />
                                    </StackPanel>

                                    <TextBlock VerticalAlignment="Center" Text="Larger files (no upper limit)">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource BodyTextStyle}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlimited}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ComboBox
                                        Grid.Column="1"
                                        Width="180"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding Options}"
                                        SelectedValue="{Binding Level, Mode=TwoWay}"
                                        SelectedValuePath="Level" />

                                    <Button
                                        Grid.Column="2"
                                        Width="36"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove rule">
                                        <ui:SymbolIcon FontSize="16" Symbol="Delete24" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SettingsCard
                    Description="File types that are compressed already (archives, BA2, audio, video, images). They are always stored without compression, whatever their size: compressing them costs time and saves almost nothing. One extension per line, for example .ba2."
                    Header="File types stored without compression"
                    Icon="{ui:SymbolIcon DocumentArrowRight24}"
                    IsStacked="True">
                    <ui:TextBox
                        Height="120"
                        AcceptsReturn="True"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        FontSize="13"
                        Text="{Binding NoCompressionExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="When all files of one backup component of a game together are larger than this (for staging: the whole modpack), every file is stored without compression. 0 turns this off."
                    Header="Store large components without compression"
                    Icon="{ui:SymbolIcon Box24}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox
                            Width="110"
                            MaxDecimalPlaces="1"
                            Minimum="0"
                            SpinButtonPlacementMode="Hidden"
                            Value="{Binding StoreComponentsLargerThanGigabytes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Width="70"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="GB" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{Binding ParallelArchivesDescription}"
                    Header="Archives written at the same time"
                    Icon="{ui:SymbolIcon Flash24}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox
                            Width="110"
                            MaxDecimalPlaces="0"
                            Minimum="1"
                            SpinButtonPlacementMode="Hidden"
                            Value="{Binding ParallelArchives, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Width="70"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="archives" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Retention" />

                <controls:SettingsCard
                    Description="Automatic safety backups older than this are deleted at startup."
                    Header="Keep safety backups"
                    Icon="{ui:SymbolIcon History24}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox
                            Width="110"
                            MaxDecimalPlaces="0"
                            Minimum="1"
                            SpinButtonPlacementMode="Hidden"
                            Value="{Binding SafetyBackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Width="70"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="days" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Newest complete snapshots kept per game and component. Archives no kept snapshot uses are removed; a paused backup is always kept."
                    Header="Keep backup snapshots"
                    Icon="{ui:SymbolIcon Archive24}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox
                            Width="110"
                            MaxDecimalPlaces="0"
                            Minimum="1"
                            SpinButtonPlacementMode="Hidden"
                            Value="{Binding MaxPreservedBackupsPerGame, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Width="70"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="snapshots" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Game configs" />

                <controls:SettingsCard
                    Description="Game-folder files that are not mod leftovers or configs worth keeping. Used only for Game configs (backup and restore); staging, Vortex AppData and custom paths are always backed up completely, and Purge ignores this list. One gitignore-style pattern per line, for example *.log, CrashDumps/ or logs/*.txt."
                    Header="Game configs ignore patterns"
                    Icon="{ui:SymbolIcon Filter24}"
                    IsStacked="True">
                    <ui:TextBox
                        Height="120"
                        AcceptsReturn="True"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        FontSize="13"
                        Text="{Binding GlobalIgnorePatternsText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>