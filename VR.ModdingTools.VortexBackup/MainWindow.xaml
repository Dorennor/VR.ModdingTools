<Window x:Class="VR.ModdingTools.VortexBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Vortex Backup Tool"
        Width="1100"
        Height="800"
        MinWidth="950"
        MinHeight="650"
        AllowsTransparency="True"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="#FFFFFF"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Custom Title Bar  -->
        <Border Grid.Row="0" Padding="12,0" Background="#007ACC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Text="Vortex Backup Tool" />

                <Button Grid.Column="1"
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        Content="−"
                        Cursor="Hand"
                        FontSize="18"
                        FontWeight="Light"
                        Foreground="#FFFFFF" />

                <Button x:Name="MaximizeButton"
                        Grid.Column="2"
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        Content="☐"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="#FFFFFF" />

                <Button Grid.Column="3"
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#FFFFFF"
                        MouseEnter="CloseButton_MouseEnter"
                        MouseLeave="CloseButton_MouseLeave" />
            </Grid>
        </Border>

        <!--  Divider  -->
        <Border Grid.Row="1" Height="1" Background="#3E3E42" />

        <!--  Settings Section  -->
        <Border Grid.Row="2"
                Padding="15,12"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!--  Google Drive Path  -->
                <TextBlock Margin="0,0,0,6"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Text="Google Drive Backup Path" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="GoogleDrivePathTextBox"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             Padding="8,6"
                             VerticalAlignment="Center"
                             Background="#3C3C3C"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             Foreground="#FFFFFF"
                             TextWrapping="NoWrap" />

                    <Button Grid.Column="1"
                            Width="80"
                            Height="32"
                            Background="#0E639C"
                            Click="BrowseGoogleDrive_Click"
                            Content="Browse"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />
                </Grid>

                <!--  Root Folders Section  -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Text="Root Folders" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="#107C10"
                            Click="AddRootFolder_Click"
                            Content="+ Add Root"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />

                    <Button Grid.Column="2"
                            Width="100"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="#FFA500"
                            Click="AddCustomFolder_Click"
                            Content="+ Add Custom"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />

                    <Button Grid.Column="3"
                            Width="75"
                            Height="28"
                            Background="#D13438"
                            Click="DeleteRootFolder_Click"
                            Content="Delete"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />
                </Grid>

                <ListBox x:Name="RootFoldersListBox"
                         Height="80"
                         Padding="6"
                         Background="#3C3C3C"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!--  Folders Selection  -->
        <Border Grid.Row="3" Padding="15,12" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Text="Select Folders to Backup" />

                    <TextBlock x:Name="FolderCounterTextBlock"
                               Grid.Column="1"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#B4B4B4"
                               Text="0 / 0 folders" />

                    <CheckBox x:Name="SelectAllCheckBox"
                              Grid.Column="2"
                              Margin="15,0,0,0"
                              VerticalAlignment="Center"
                              Click="SelectAllCheckBox_Click"
                              Content="Select All"
                              FontSize="11"
                              Foreground="#CCCCCC" />
                </Grid>

                <ListBox x:Name="FoldersListBox"
                         Grid.Row="1"
                         Background="#252526"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,8" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Text="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="#999999" Text="{Binding FullPath}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Pagination  -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="PrevPageButton"
                            Width="90"
                            Height="28"
                            Margin="0,0,12,0"
                            Background="#555555"
                            Click="PrevPage_Click"
                            Content="← Previous"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />

                    <TextBlock x:Name="PageIndicator"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               Text="Page 1 of 1" />

                    <Button x:Name="NextPageButton"
                            Width="90"
                            Height="28"
                            Background="#555555"
                            Click="NextPage_Click"
                            Content="Next →"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Status  -->
        <Border Grid.Row="4" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Padding="15,8"
                       FontSize="10"
                       Foreground="#4EC9B0"
                       Text="Ready" />
        </Border>

        <!--  Backup and Cancel Buttons  -->
        <Border Grid.Row="5" Padding="15,12" Background="#252526">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackupButton"
                        Grid.Column="0"
                        Height="38"
                        Background="#007ACC"
                        Click="StartBackup_Click"
                        Content="Start Backup"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Height="38"
                        Margin="10,0,0,0"
                        Background="#D13438"
                        Click="CancelOperation_Click"
                        Content="Cancel"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>